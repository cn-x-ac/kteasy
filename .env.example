# Kteasy 开发环境变量模板（M0-02）。复制为 .env 后按需改；compose 与应用共用同一批键，改一处即三处同步。
#   cp .env.example .env
# 值均为本地开发默认，切勿用于生产。

# ---- 数据库（同一时刻只起一种方言：SPRING_PROFILES_ACTIVE=pg 或 mysql）----
KTEASY_DB_NAME=kteasy
KTEASY_DB_USER=kteasy
KTEASY_DB_PASSWORD=kteasy
# pg 默认 5432 / mysql 默认 3306；本地跑 pg 用 5432，跑 mysql 改 3306
KTEASY_DB_HOST=localhost
KTEASY_DB_PORT=5432
KTEASY_MYSQL_ROOT_PASSWORD=rootpass

# ---- 对象存储（S3 / MinIO）：本卡只留配置位，不接线 ----
KTEASY_S3_ENDPOINT=http://localhost:9000
KTEASY_S3_BUCKET=kteasy
KTEASY_S3_REGION=us-east-1
KTEASY_S3_ACCESS_KEY=kteasyadmin
KTEASY_S3_SECRET_KEY=kteasysecret
